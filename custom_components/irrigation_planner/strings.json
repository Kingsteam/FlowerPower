{
  "config": {
    "step": {
      "user": {
        "title": "Set up Irrigation Planner",
        "description": "Basic settings. At most {max_open_valves} valve per water supply is open at any time.",
        "data": {
          "weather_entity": "Weather source",
          "window_start": "Watering window start",
          "window_end": "Watering window end"
        },
        "data_description": {
          "weather_entity": "Optional. A weather entity used for rain and frost forecasts.",
          "window_start": "Earliest start of a watering run.",
          "window_end": "The watering run must be finished by this time."
        }
      }
    },
    "error": {
      "window_empty": "Start and end of the watering window must not be equal."
    },
    "abort": {
      "single_instance_allowed": "Irrigation Planner is already configured."
    }
  },
  "services": {
    "run_zone": {
      "name": "Water zone",
      "description": "Queues a zone for the given duration. Only one valve per water supply is open at a time; a start during a run waits in the queue.",
      "fields": {
        "zone_id": {
          "name": "Zone ID",
          "description": "ID of the zone."
        },
        "duration": {
          "name": "Duration",
          "description": "Watering time in seconds. Limited to the zone's maximum duration."
        }
      }
    },
    "stop_all": {
      "name": "Stop all",
      "description": "Empties all queues and closes all valves."
    },
    "run_program": {
      "name": "Start program",
      "description": "Queues all zones of a program now.",
      "fields": {
        "program_id": {
          "name": "Program ID",
          "description": "ID of the program."
        }
      }
    },
    "skip_next": {
      "name": "Skip next run",
      "description": "Skips the next scheduled start of a program once.",
      "fields": {
        "program_id": {
          "name": "Program ID",
          "description": "ID of the program."
        }
      }
    }
  },
